    {
      "id": "brand_info",
      "section": "About Your Brand",
      "number": "01",
      "question": "Tell us about your brand.",
      "subtitle": "Let's start with the basics.",
      "type": "group",
      "fields": [
        {
          "id": "f-brand-name",
          "type": "text",
          "placeholder": "Brand / Business Name",
          "required": true
        },
        {
          "id": "f-website",
          "type": "url",
          "placeholder": "Website (if any)",
          "required": false
        },
        {
          "id": "f-socials",
          "type": "text",
          "placeholder": "Instagram / Social Media Links",
          "required": false
        },
        {
          "id": "f-offer",
          "type": "textarea",
          "placeholder": "What do you offer? (Products / Services)",
          "rows": 3,
          "required": true
        },
        {
          "id": "f-choose-you",
          "type": "textarea",
          "placeholder": "Why do people choose you?",
          "rows": 3,
          "required": true
        }
      ]
    },
    {
